# Copy this file to .env and fill the values. Never commit .env.
# All values below stay on the server. Nothing here reaches the browser.

# Storage root (created on first run)
DATA_DIR=./data

# Server bind (keep 127.0.0.1 while there is no login system)
HOST=127.0.0.1
PORT=8000

# AI key (free AI Studio key, no card needed)
GEMINI_API_KEY=

# Vision: bulky extraction on the light high quota model
VISION_PROVIDER=gemini
VISION_MODEL=gemini-3.5-flash-lite
VISION_PAGES_PER_CALL=8
VISION_MIN_INTERVAL_SEC=5
VISION_DAILY_CAP=500

# Narrative text (summary plus script): strong model, 2 calls a chapter
TEXT_MODEL=gemini-3.8-flash
TEXT_DAILY_CAP=20

# Voice (edge needs no key)
TTS_PROVIDER=edge
EDGE_TTS_VOICE=en-US-AriaNeural

# Optional override of the bundled video binary
FFMPEG_PATH=

# Upload guard in megabytes
MAX_UPLOAD_MB=500

# Background worker threads
JOB_WORKERS=2

# API base used by the frontend in dev only (empty in prod means same origin)
VITE_API_URL=http://127.0.0.1:8000
